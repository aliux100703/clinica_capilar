# Origen público definitivo, sin ruta. Vacío hasta confirmar el dominio.
SITE_URL=
# Activar únicamente tras verificar identidad, servicios y contenido médico.
SEO_INDEXABLE=false
# Solo servidor: consultas de catálogo desde Next.js.
API_URL=http://127.0.0.1:8000/api/v1
# URL pública de la API para formularios; no contiene secretos.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Mantener false hasta reemplazar /privacidad por la política revisada.
PRIVACY_POLICY_APPROVED=false
# Solo servidor. Debe coincidir con Laravel; nunca usar NEXT_PUBLIC para este secreto.
CMS_REVALIDATE_SECRET=
